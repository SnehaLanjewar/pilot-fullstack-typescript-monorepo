{
  "name": "pilot-fullstack-typescript-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm run dev -w @pilot/web\" \"npm run dev -w @pilot/api\"",
    "dev:web": "npm run dev -w @pilot/web",
    "dev:api": "npm run dev -w @pilot/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
